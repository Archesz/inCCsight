# ─────────────────────────────────────────────────────────────────────────────
# inCCsight environment configuration
# Copy this file to .env and edit the values below.
# ─────────────────────────────────────────────────────────────────────────────

# Port that the inCCsight server listens on (default: 3001)
PORT=3001

# Path to your DTI subject data on the host machine.
# This folder is mounted read-only inside the container as /mnt/subjects.
# In the inCCsight UI, use paths like /mnt/subjects/subject001
#
# Windows example:  SUBJECTS_DIR=C:\Users\you\mri_data
# macOS example:    SUBJECTS_DIR=/Users/you/mri_data
# Linux example:    SUBJECTS_DIR=/home/you/mri_data
SUBJECTS_DIR=./subjects

# (Optional) Direct download URL for the CNN model checkpoint.
# Leave blank if you are placing the .ckpt file manually in
# methods/CNNBased/peso/
INCCSIGHT_MODEL_URL=

# (Optional) Direct download URL for the ViT Quality-Control model.
# Normally the .pth in methods/models/ is baked into the Docker image.
# Set this only if the model is NOT baked in and you want the container to
# download it at startup. Leave blank otherwise.
INCCSIGHT_QC_MODEL_URL=
